              <button onclick="switchTab('home'); closeMenu()" id="nav-home" class="nav-btn group w-full text-left px-4 py-2.5 text-xs font-mono uppercase tracking-wider flex items-center justify-between text-gray-300 hover:text-white hover:bg-white/10 transition-colors">
