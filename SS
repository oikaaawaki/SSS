/* ==================== FAN TOOLS ==================== */
function castVote(option) {
  if (userComoBalance < 1) {
    alert('Not enough COMO available!');
    return;
  }
  userComoBalance -= 1;
  if (option === 'a') votesTrackA += 1;
  if (option === 'b') votesTrackB += 1;

  const balEl = document.getElementById('sim-como-balance');
  if (balEl) balEl.innerText = `${userComoBalance} COMO`;

  alert('Vote successfully recorded!');
}

function renderObjektChecklist() {
  const container = document.getElementById('objekt-checklist');
  if (!container) return;

  container.innerHTML = OBJEKTS.map(obj => `
    <label class="flex items-center justify-between p-2.5 bg-black border border-white/15 rounded cursor-pointer hover:border-white">
      <div>
        <div class="text-white font-bold">${obj.name}</div>
        <div class="text-brand-silver text-[10px]">${obj.member}</div>
      </div>
      <input type="checkbox" class="accent-white w-4 h-4" />
    </label>
  `).join('');
}

/* ==================== FANSITES FUNCTIONS ==================== */

function renderMemberSelectorStrip() {
  const container = document.getElementById('fansite-member-selector');
  if (!container) return;

  let html = `
    <button 
      onclick="selectFansiteMember('ALL')" 
      class="fansite-mem-btn shrink-0 border border-white/30 px-3 py-1.5 rounded text-xs font-mono uppercase transition-all ${selectedMemberFansite === 'ALL' ? 'bg-white text-black font-bold' : 'bg-black text-white hover:border-white'}"
    >
      ALL MEMBERS
    </button>
  `;

  MEMBERS.forEach(m => {
    const active = selectedMemberFansite === m.s;
    html += `
      <button 
        onclick="selectFansiteMember('${m.s}')" 
        class="fansite-mem-btn shrink-0 border border-white/20 px-3 py-1.5 rounded text-xs font-mono transition-all flex items-center gap-1.5 ${active ? 'bg-white text-black font-bold' : 'bg-black text-white hover:border-white'}"
      >
        <span class="font-bold">${m.s}</span>
        <span class="text-[10px] opacity-75">${m.name.split(" ")[0]}</span>
      </button>
    `;
  });

  container.innerHTML = html;
}

function selectFansiteMember(sNum) {
  selectedMemberFansite = sNum;
  renderMemberSelectorStrip();
  filterFansites();
}

function filterFansites() {
  const searchVal = (document.getElementById('fansite-search-input')?.value || '').toLowerCase();
  const statusVal = document.getElementById('fansite-status-select')?.value || 'ALL';
  const typeVal = document.getElementById('fansite-type-select')?.value || 'ALL';

  const filtered = FANSITES_DATA.filter(item => {
    const matchesMember = selectedMemberFansite === 'ALL' || item.memberS === selectedMemberFansite;
    const matchesSearch = item.handle.toLowerCase().includes(searchVal) || item.name.toLowerCase().includes(searchVal);
    const matchesStatus = statusVal === 'ALL' || item.status === statusVal;
    const matchesType = typeVal === 'ALL' || item.type === typeVal;

    return matchesMember && matchesSearch && matchesStatus && matchesType;
  });

  renderFansitesGrid(filtered);
}

function renderFansitesGrid(list) {
  const grid = document.getElementById('fansites-grid');
  const countEl = document.getElementById('fansite-count');
  if (countEl) countEl.innerText = `Showing ${list.length} fansites`;

  if (!grid) return;

  if (list.length === 0) {
    grid.innerHTML = `
      <div class="col-span-full text-center py-12 border border-white/10 rounded font-mono text-xs text-brand-silver">
        No fansites registered for this member filter. <button onclick="openFansiteModal()" class="text-white underline">Submit one!</button>
      </div>
    `;
    return;
  }

  grid.innerHTML = list.map(item => {
    const mem = MEMBERS.find(m => m.s === item.memberS) || { name: 'Member' };
    const isBookmarked = bookmarkedFansites.includes(item.id);

    return `
      <div class="glass-card p-5 rounded-lg border border-white/15 hover:border-white transition-all flex flex-col justify-between space-y-4 group">
        <div>
          <div class="flex items-start justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-6 h-6 bg-white/10 border border-white/20 rounded-full flex items-center justify-center text-[10px] font-mono font-bold text-white">
                ${item.memberS}
              </span>
              <span class="text-xs font-mono text-brand-silver">${mem.name}</span>
            </div>
            <button onclick="toggleBookmark('${item.id}')" class="text-brand-silver hover:text-white">
              <i data-lucide="bookmark" class="w-4 h-4 ${isBookmarked ? 'fill-white text-white' : ''}"></i>
            </button>
          </div>

          <div class="mt-3 space-y-1">
            <h3 class="text-base font-mono font-bold text-white group-hover:underline">${item.handle}</h3>
            <div class="text-xs text-gray-300 font-light">${item.name}</div>
          </div>
        </div>

        <div class="space-y-3 pt-3 border-t border-white/10">
          <div class="flex items-center justify-between text-[10px] font-mono">
            <span class="px-2 py-0.5 border border-white/20 rounded text-brand-silver">${item.type}</span>
            <span class="flex items-center gap-1 ${item.status === 'Active' ? 'text-white font-bold' : 'text-gray-500'}">
              <span class="w-1.5 h-1.5 rounded-full ${item.status === 'Active' ? 'bg-white animate-pulse' : 'bg-gray-500'}"></span>
              ${item.status}
            </span>
          </div>

          <a href="${item.url}" target="_blank" class="w-full py-1.5 bg-white text-black font-mono font-bold text-xs uppercase rounded flex items-center justify-center gap-1.5 hover:bg-gray-200 transition-colors">
            Visit Profile <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
          </a>
        </div>
      </div>
    `;
  }).join("");

  lucide.createIcons();
}

function toggleBookmark(id) {
  if (bookmarkedFansites.includes(id)) {
    bookmarkedFansites = bookmarkedFansites.filter(bId => bId !== id);
  } else {
    bookmarkedFansites.push(id);
  }
  localStorage.setItem('sss_bookmarked_fansites', JSON.stringify(bookmarkedFansites));
  filterFansites();
}

function openFansiteModal() {
  const select = document.getElementById('submit-member');
  if (select) {
    select.innerHTML = MEMBERS.map(m => `<option value="${m.s}">${m.s} - ${m.name}</option>`).join("");
  }
  document.getElementById('fansite-modal').classList.remove('hidden');
}

function closeFansiteModal() {
  document.getElementById('fansite-modal').classList.add('hidden');
}

function handleFansiteSubmit(e) {
  e.preventDefault();
  const memS = document.getElementById('submit-member').value;
  const handle = document.getElementById('submit-handle').value;
  const type = document.getElementById('submit-type').value;
  const url = document.getElementById('submit-url').value;

  const newFansite = {
    id: 'f_' + Date.now(),
    memberS: memS,
    handle: handle.startsWith('@') ? handle : '@' + handle,
    name: handle.replace('@', '') + ' Fansite',
    type: type,
    status: 'Active',
    url: url
  };

  FANSITES_DATA.unshift(newFansite);
  filterFansites();
  closeFansiteModal();
  alert('Fansite submitted successfully!');
}

/* ==================== INITIALIZATION ==================== */
window.onload = function() {
  lucide.createIcons();
  renderSubunits(SUBUNITS_DATA);
  buildAlphabetStrip();
  renderGlossary(GLOSSARY_TERMS);
  renderMembers(MEMBERS);
  renderMemberSelectorStrip();
  filterFansites();
  renderDiscography(ALBUMS);
  renderObjektChecklist();
};
</script>
