}

function searchMembers() {
  const val = (document.getElementById('member-search-input')?.value || '').toLowerCase();
  const filtered = MEMBERS.filter(m => 
    m.s.toLowerCase().includes(val) || m.name.toLowerCase().includes(val)
  );
  renderMembers(filtered);
}

function renderMembers(list) {
  const grid = document.getElementById('members-grid');
  if (!grid) return;

  grid.innerHTML = list.map(m => `
    <div class="glass-card p-4 rounded-lg border border-white/15 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-lg font-mono font-bold text-white">${m.s}</span>
        <span class="text-[10px] font-mono border border-white/20 px-2 py-0.5 rounded text-brand-silver">${m.nat}</span>
      </div>
      <div>
        <h3 class="text-base font-mono font-bold text-white">${m.name}</h3>
        <p class="text-[11px] font-mono text-brand-silver mt-0.5">DOB: ${m.birth}</p>
      </div>
      <div class="flex flex-wrap gap-1 pt-2 border-t border-white/10">
        ${m.units.map(u => `<span class="text-[9px] font-mono bg-white/10 border border-white/15 px-1.5 py-0.5 rounded text-gray-300">${u}</span>`).join('')}
      </div>
    </div>
  `).join('');
}

/* ==================== DISCOGRAPHY FUNCTIONS ==================== */
function renderDiscography(list) {
  const grid = document.getElementById('discography-grid');
  if (!grid) return;

  grid.innerHTML = list.map(album => `
    <div class="glass-card p-6 rounded-lg border border-white/15 space-y-4">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-brand-silver">${album.type}</span>
          <h3 class="text-xl font-mono font-bold text-white mt-1">${album.title}</h3>
          <p class="text-xs font-mono text-brand-silver">${album.unit}</p>
        </div>
        <span class="text-xs font-mono text-brand-silver">${album.date}</span>
      </div>
      
      <div class="space-y-2">
        <div class="text-xs font-mono font-bold text-white flex items-center gap-1.5">
          <i data-lucide="disc" class="w-3.5 h-3.5"></i> Title Track: ${album.lead}
        </div>
        <div class="space-y-1">
          <span class="text-[10px] font-mono text-brand-silver block uppercase">Tracklist:</span>
          <div class="flex flex-wrap gap-1.5">
            ${album.tracks.map((t, idx) => `
              <span class="text-[10px] font-mono bg-black border border-white/20 px-2 py-0.5 rounded text-gray-300">
                0${idx + 1}. ${t}
              </span>
            `).join('')}
          </div>
        </div>
