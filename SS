                <span class="text-[10px] text-brand-silver group-hover:text-white">09</span>
              </button>
            </div>

            <!-- Menu Footer -->
            <div class="px-4 pt-2.5 pb-1 text-[10px] font-mono text-brand-silver flex items-center justify-between">
              <span>SYSTEM: COSMO v24</span>
              <span>SSS.log</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</header>

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- ==================== HOME TAB ==================== -->
  <section id="tab-home" class="space-y-12">
    <!-- Hero Banner with tripleS Group Visual Background -->
    <div class="relative rounded-lg border border-white/20 p-8 sm:p-12 overflow-hidden min-h-[420px] flex flex-col justify-between">
      
