/* ==================== GLOSSARY FUNCTIONS ==================== */
function buildAlphabetStrip() {
  const container = document.getElementById('alphabet-strip');
  if (!container) return;

  const letters = ['ALL', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')];
  container.innerHTML = letters.map(char => `
    <button 
      onclick="filterByLetter('${char}')"
      class="px-2 py-1 rounded border border-white/20 transition-all ${selectedLetter === char ? 'bg-white text-black font-bold' : 'hover:border-white text-brand-silver'}"
    >
      ${char}
    </button>
  `).join('');
}

function filterByLetter(char) {
  selectedLetter = char;
  buildAlphabetStrip();
  filterGlossary();
}

function filterGlossary() {
  const searchVal = (document.getElementById('glossary-search-input')?.value || '').toLowerCase();
  const catVal = document.getElementById('glossary-category-select')?.value || 'ALL';

  const filtered = GLOSSARY_TERMS.filter(item => {
    const matchesLetter = selectedLetter === 'ALL' || item.term.toUpperCase().startsWith(selectedLetter);
    const matchesSearch = item.term.toLowerCase().includes(searchVal) || item.definition.toLowerCase().includes(searchVal);
    const matchesCat = catVal === 'ALL' || item.category === catVal;

    return matchesLetter && matchesSearch && matchesCat;
  });

  renderGlossary(filtered);
}

function clearGlossaryFilters() {
  selectedLetter = 'ALL';
  const searchInput = document.getElementById('glossary-search-input');
  const catSelect = document.getElementById('glossary-category-select');
  if (searchInput) searchInput.value = '';
  if (catSelect) catSelect.value = 'ALL';
  buildAlphabetStrip();
  filterGlossary();
}

function renderGlossary(list) {
  const grid = document.getElementById('glossary-grid');
  const countEl = document.getElementById('glossary-count');
  if (countEl) countEl.innerText = `Showing ${list.length} terms`;

  if (!grid) return;

  if (list.length === 0) {
    grid.innerHTML = `
      <div class="col-span-full text-center py-12 border border-white/10 rounded font-mono text-xs text-brand-silver">
        No glossary terms matched your filter criteria.
      </div>
    `;
    return;
  }

  grid.innerHTML = list.map(item => `
    <div class="glass-card p-5 rounded-lg border border-white/15 space-y-3">
      <div class="flex items-start justify-between">
        <h3 class="text-base font-mono font-bold text-white">${item.term}</h3>
        <span class="text-[10px] font-mono border border-white/20 px-2 py-0.5 rounded text-brand-silver">${item.category}</span>
      </div>
      <p class="text-xs text-gray-300 font-light leading-relaxed">${item.definition}</p>
      ${item.related ? `
        <div class="pt-2 border-t border-white/10 flex items-center gap-1.5 text-[10px] font-mono text-brand-silver">
          <span>RELATED:</span>
          ${item.related.map(r => `<span class="bg-white/10 text-white px-1.5 py-0.5 rounded">${r}</span>`).join('')}
        </div>
      ` : ''}
    </div>
  `).join('');
}

