  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- Custom Monochromatic Grid & Cyber Aesthetics -->
  <style>
    body {
      background-color: #000000;
      color: #f5f5f5;
      font-family: 'DM Sans', sans-serif;
    }

    h1, h2, h3, h4, h5, h6, .display-font {
      font-family: 'Space Grotesk', sans-serif;
    }
    
    .bg-grid-pattern {
      background-size: 32px 32px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }

    .bg-grid-dense {
      background-size: 16px 16px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #000000;
    }
    ::-webkit-scrollbar-thumb {
      background: #333333;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #ffffff;
    }

    .border-glow {
      transition: all 0.2s ease-in-out;
    }
    .border-glow:hover {
      border-color: #ffffff;
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    }

    .mono-font {
      font-family: 'JetBrains Mono', monospace;
    }

    .glass-card {
      background: rgba(18, 18, 18, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
  </style>
</head>
<body class="min-h-screen bg-black text-white bg-grid-pattern flex flex-col selection:bg-white selection:text-black">

<header class="sticky top-0 z-50 bg-black/90 backdrop-blur-md border-b border-white/20">
