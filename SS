  const btns = document.querySelectorAll('#subunit-category-filters button');
  btns.forEach(b => {
    b.classList.remove('bg-white', 'text-black', 'font-bold');
    b.classList.add('text-white');
  });

  event.target.classList.add('bg-white', 'text-black', 'font-bold');
  event.target.classList.remove('text-white');

  if (category === 'ALL') {
    renderSubunits(SUBUNITS_DATA);
