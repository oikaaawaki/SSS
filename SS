            class="flex items-center gap-2 px-3 py-1.5 bg-black hover:bg-white/10 text-white border border-white/30 rounded focus:outline-none transition-all"
          >
            <i data-lucide="menu" id="menu-icon" class="w-5 h-5"></i>
            <span class="text-xs font-mono uppercase tracking-wider hidden xs:inline-block">Menu</span>
            <i data-lucide="chevron-down" id="menu-arrow" class="w-3.5 h-3.5 transition-transform duration-200"></i>
