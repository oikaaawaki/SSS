              <button onclick="switchTab('lore'); closeMenu()" id="nav-lore" class="nav-btn group w-full text-left px-4 py-2.5 text-xs font-mono uppercase tracking-wider flex items-center justify-between text-gray-300 hover:text-white hover:bg-white/10 transition-colors">
                <span class="flex items-center gap-2.5"><i data-lucide="network" class="w-4 h-4"></i> Lore & System</span>
                <span class="text-[10px] text-brand-silver group-hover:text-white">08</span>
              </button>
              <button onclick="switchTab('tools'); closeMenu()" id="nav-tools" class="nav-btn group w-full text-left px-4 py-2.5 text-xs font-mono uppercase tracking-wider flex items-center justify-between text-gray-300 hover:text-white hover:bg-white/10 transition-colors">
