/* ==================== NAVIGATION CONTROLLER ==================== */
function toggleMenu() {
  const dropdown = document.getElementById('nav-dropdown');
  const arrow = document.getElementById('menu-arrow');
  const isHidden = dropdown.classList.contains('hidden');

  if (isHidden) {
    dropdown.classList.remove('hidden');
    if (arrow) arrow.style.transform = 'rotate(180deg)';
  } else {
    closeMenu();
  }
}

function closeMenu() {
  const dropdown = document.getElementById('nav-dropdown');
  const arrow = document.getElementById('menu-arrow');
  if (dropdown) dropdown.classList.add('hidden');
  if (arrow) arrow.style.transform = 'rotate(0deg)';
}

document.addEventListener('click', (e) => {
  const wrapper = document.getElementById('dropdown-menu-wrapper');
  if (wrapper && !wrapper.contains(e.target)) {
    closeMenu();
  }
});

function switchTab(tabId) {
  currentTab = tabId;

  const tabs = ['home', 'subunits', 'glossary', 'members', 'fansites', 'guide', 'discography', 'lore', 'tools'];
  tabs.forEach(t => {
    const el = document.getElementById(`tab-${t}`);
    if (el) el.classList.add('hidden');

    const navBtn = document.getElementById(`nav-${t}`);
    if (navBtn) {
      navBtn.classList.remove('bg-white', 'text-black', 'font-bold');
      navBtn.classList.add('text-gray-300');
    }
  });

  const activeSection = document.getElementById(`tab-${tabId}`);
  if (activeSection) activeSection.classList.remove('hidden');

  const activeNav = document.getElementById(`nav-${tabId}`);
  if (activeNav) {
    activeNav.classList.add('bg-white', 'text-black', 'font-bold');
    activeNav.classList.remove('text-gray-300');
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function handleGlobalSearch(event) {
  const query = event.target.value.toLowerCase().trim();
  if (event.key === 'Enter' && query) {
    switchTab('subunits');
    const searchInput = document.getElementById('subunit-search-input');
    if (searchInput) {
      searchInput.value = query;
      searchSubunits();
    }
  }
}

