<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SSS.log — tripleS Wiki & Fandom Log</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#000000',
              dark: '#0a0a0a',
              card: '#121212',
              surface: '#1a1a1a',
              border: '#2a2a2a',
              lightborder: '#404040',
              silver: '#a3a3a3',
              light: '#f5f5f5',
              white: '#ffffff',
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'Space Grotesk', 'Courier New', 'monospace'],
          },
          boxShadow: {
            'glow-sm': '0 0 10px rgba(255, 255, 255, 0.15)',
            'glow-md': '0 0 20px rgba(255, 255, 255, 0.25)',
            'glow-lg': '0 0 35px rgba(255, 255, 255, 0.35)',
            'glow-button': '0 0 15px rgba(255, 255, 255, 0.4)',
          }
        }
      }
    }
  </script>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
