        let currentPage = 'home';

        function switchPage(page) {
            currentPage = page;
            const pages = ['home', 'guide', 'members', 'subunits', 'discography', 'glossary', 'fansites', 'lore'];
            
            pages.forEach(p => {
                const el = document.getElementById(p + 'Page');
                if (el) el.classList.add('hidden');
                
                const navBtn = document.getElementById('nav' + p.charAt(0).toUpperCase() + p.slice(1) + 'Btn');
                if (navBtn) navBtn.className = "px-3 py-2 rounded-xl transition-all font-semibold text-neutral-400 hover:text-white";
                
                const mNavBtn = document.getElementById('mNav' + p.charAt(0).toUpperCase() + p.slice(1));
                if (mNavBtn) mNavBtn.className = "px-3 py-1.5 rounded-lg whitespace-nowrap bg-neutral-900 text-neutral-300 border border-neutral-800 font-medium";
            });

            const activeEl = document.getElementById(page + 'Page');
            if (activeEl) activeEl.classList.remove('hidden');

            const activeNavBtn = document.getElementById('nav' + page.charAt(0).toUpperCase() + page.slice(1) + 'Btn');
            if (activeNavBtn) activeNavBtn.className = "px-3 py-2 rounded-xl transition-all font-bold bg-white text-black";

            const activeMNavBtn = document.getElementById('mNav' + page.charAt(0).toUpperCase() + page.slice(1));
            if (activeMNavBtn) activeMNavBtn.className = "px-3 py-1.5 rounded-lg whitespace-nowrap bg-white text-black font-bold";

            // Render views as needed
            if (page === 'home') renderHomePreview();
            if (page === 'members') renderMembers();
            if (page === 'subunits') renderSubunits();
            if (page === 'discography') renderDiscography();
            if (page === 'glossary') renderGlossary();
            if (page === 'fansites') renderFansites();
        }

        function renderHomePreview() {
            const preview = document.getElementById('homeMemberPreview');
            if (!preview) return;
            preview.innerHTML = TRIPLES_MEMBERS.slice(0, 12).map(m => `
                <div onclick="switchPage('members')" class="bg-neutral-900 rounded-2xl border border-neutral-800 p-2 cursor-pointer hover:border-neutral-500 transition-all">
                    <img src="${m.photo}" alt="${m.name}" class="w-full aspect-square object-cover rounded-xl bg-black mb-2 grayscale hover:grayscale-0 transition-all">
                    <span class="text-[10px] font-mono font-bold text-neutral-400">${m.sNum}</span>
                    <h4 class="font-bold text-xs text-white truncate">${m.name}</h4>
                </div>
            `).join('');
        }

        function renderMembers() {
            const grid = document.getElementById('memberGrid');
            if (!grid) return;
            grid.innerHTML = TRIPLES_MEMBERS.map(m => `
                <div class="bg-neutral-900 rounded-2xl border border-neutral-800 p-3 hover:border-neutral-500 transition-all space-y-2">
                    <img src="${m.photo}" class="w-full aspect-square object-cover rounded-xl bg-black grayscale hover:grayscale-0 transition-all">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-black text-white border border-neutral-800">${m.sNum}</span>
