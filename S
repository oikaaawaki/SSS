        function renderGlossary() {
            const list = document.getElementById('glossaryList');
            if (!list) return;
            const filter = (document.getElementById('glossarySearchInput')?.value || '').toLowerCase();
            const filtered = TRIPLES_GLOSSARY.filter(g => g.term.toLowerCase().includes(filter) || g.def.toLowerCase().includes(filter));
            
            list.innerHTML = filtered.map(g => `
                <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 space-y-1">
                    <h4 class="font-bold text-sm text-white font-mono">${g.term}</h4>
                    <p class="text-xs text-neutral-400 leading-relaxed">${g.def}</p>
                </div>
            `).join('');
        }

