            const grid = document.getElementById('subunitsGrid');
            if (!grid) return;
            grid.innerHTML = TRIPLES_SUBUNITS.map(u => `
                <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 space-y-3">
